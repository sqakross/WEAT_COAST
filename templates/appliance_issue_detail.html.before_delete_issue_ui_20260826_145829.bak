{% extends "base.html" %}
{% block content %}

<style>
  .issue-slip-page {
    max-width:950px;
    margin:0 auto;
  }

  .issue-slip {
    background:#fff;
    border:1px solid #cfd4da;
    border-radius:.45rem;
    padding:1.5rem;
  }

  .slip-title {
    font-size:1.45rem;
    font-weight:800;
  }

  .slip-number {
    font-size:1.05rem;
    font-weight:700;
  }

  .slip-label {
    font-size:.69rem;
    color:#6c757d;
    font-weight:700;
    text-transform:uppercase;
  }

  .slip-value {
    font-weight:700;
  }

  .appliance-line {
    border:1px solid #d9dee5;
    border-radius:.4rem;
    padding:.75rem .85rem;
    margin-bottom:.55rem;
    background:#fff;
  }

  .appliance-line-number {
    width:32px;
    min-width:32px;
    height:32px;
    border-radius:50%;
    background:#e9ecef;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
    font-size:.8rem;
  }

  .appliance-line-type {
    font-size:1rem;
    font-weight:800;
    letter-spacing:.02em;
  }

  .appliance-line-details {
    font-size:.86rem;
    margin-top:.15rem;
  }

  .appliance-line-details span {
    font-weight:600;
  }

  @media print {

    body {
      background:#fff !important;
    }

    .no-print,
    nav,
    footer,
    .alert {
      display:none !important;
    }

    .container,
    .container-fluid {
      max-width:none !important;
      width:100% !important;
      padding:0 !important;
      margin:0 !important;
    }

    .issue-slip-page {
      max-width:none;
      width:100%;
      margin:0;
    }

    .issue-slip {
      border:0;
      padding:0;
    }

    .appliance-line {
      border:0;
      border-bottom:1px solid #bbb;
      border-radius:0;
      padding:.45rem 0;
      margin:0;
      page-break-inside:avoid;
    }

    .appliance-line-number {
      background:#fff;
      border:1px solid #bbb;
    }

    @page {
      size:letter;
      margin:.45in;
    }
  }
</style>


<div class="issue-slip-page">

  <div class="d-flex justify-content-between align-items-center mb-3 no-print">

    <a class="btn btn-outline-secondary btn-sm"
       href="{{ url_for('appliance.inventory_list') }}">
      ← Inventory
    </a>

    <div class="d-flex gap-2">

      <a class="btn btn-primary btn-sm"
         href="{{ url_for('appliance.issue_new') }}">
        + New Issue
      </a>

      <button type="button"
              class="btn btn-success btn-sm"
              onclick="window.print();">
        Print
      </button>

    </div>

  </div>


  <div class="issue-slip">

    <div class="text-center mb-4">

      <div class="fw-bold">
        WEST COAST CHIEF REPAIR
      </div>

      <div class="slip-title">
        APPLIANCE ISSUE SLIP
      </div>

      <div class="slip-number">
        {{ issue.issue_number }}
      </div>

    </div>


    <div class="row g-3 mb-4">

      <div class="col-6 col-md-4">

        <div class="slip-label">
          Date
        </div>

        <div class="slip-value">
          {% if issue.issued_at_local %}
            {{ issue.issued_at_local.strftime('%m/%d/%Y %I:%M %p') }}
          {% else %}
            —
          {% endif %}
        </div>

      </div>


      <div class="col-6 col-md-4">

        <div class="slip-label">
          Technician
        </div>

        <div class="slip-value">
          {{ issue.technician_username|upper }}
        </div>

      </div>


      <div class="col-6 col-md-4">

        <div class="slip-label">
          Work Order
        </div>

        <div class="slip-value">
          {{ issue.work_order_number|upper }}
        </div>

      </div>


      <div class="col-6 col-md-4">

        <div class="slip-label">
          Warehouse
        </div>

        <div class="slip-value">
          {{ issue.warehouse.code|upper if issue.warehouse else '—' }}
        </div>

      </div>


      <div class="col-6 col-md-4">

        <div class="slip-label">
          Issued By
        </div>

        <div class="slip-value">
          {{ issue.issued_by.username|upper if issue.issued_by else '—' }}
        </div>

      </div>


      <div class="col-6 col-md-4">

        <div class="slip-label">
          Units
        </div>

        <div class="slip-value">
          {{ issue.appliance_count }}
        </div>

      </div>

    </div>


    <div class="mb-4">

      {% for line in issue.lines %}

        <div class="appliance-line">

          <div class="d-flex align-items-start gap-3">

            <div class="appliance-line-number">
              {{ line.line_no }}
            </div>

            <div class="flex-grow-1">

              <div class="appliance-line-type">
                {{ (line.appliance_type_snapshot or '—')|upper }}
              </div>

              <div class="appliance-line-details">

                <span>
                  {{ (line.brand_snapshot or '—')|upper }}
                </span>

                <span class="mx-1">|</span>

                <span>
                  {{ (line.model_number_snapshot or '—')|upper }}
                </span>

                <span class="mx-1">|</span>

                <span>
                  {{ (line.serial_number_snapshot or '—')|upper }}
                </span>

              </div>

            </div>

          </div>

        </div>

      {% endfor %}

    </div>


    {% if issue.notes %}

      <div class="mt-3">

        <div class="slip-label">
          Notes
        </div>

        <div>
          {{ issue.notes|upper }}
        </div>

      </div>

    {% endif %}


    <div class="row mt-5">

      <div class="col-6">

        <div style="border-top:1px solid #000; padding-top:.3rem;">
          Issued By
        </div>

      </div>

      <div class="col-6">

        <div style="border-top:1px solid #000; padding-top:.3rem;">
          Technician Signature
        </div>

      </div>

    </div>

  </div>

</div>


{% if auto_print %}

<script>
window.addEventListener(
  "load",
  () => {
    setTimeout(
      () => window.print(),
      350
    );
  }
);
</script>

{% endif %}

{% endblock %}