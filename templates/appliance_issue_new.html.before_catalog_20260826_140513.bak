{% extends "base.html" %}
{% block content %}

<style>
  .issue-page {
    width: min(1500px, calc(100vw - 40px));
    margin-left:auto;
    margin-right:auto;
  }

  .issue-card {
    background:#fff;
    border:1px solid #d9dee5;
    border-radius:.55rem;
    box-shadow:0 .15rem .45rem rgba(0,0,0,.07);
  }

  .issue-label {
    font-size:.68rem;
    font-weight:700;
    color:#6c757d;
    text-transform:uppercase;
    margin-bottom:.25rem;
  }

  .issue-page input[type="text"],
  .issue-page input[type="search"],
  .issue-page textarea {
    text-transform:uppercase;
  }

  .search-box {
    position:relative;
  }

  .search-results {
    position:absolute;
    top:100%;
    left:0;
    right:0;
    z-index:1000;
    background:#fff;
    border:1px solid #ced4da;
    border-radius:.35rem;
    box-shadow:0 .35rem .8rem rgba(0,0,0,.14);
    max-height:330px;
    overflow-y:auto;
  }

  .search-result {
    padding:.55rem .7rem;
    border-bottom:1px solid #eceff2;
    cursor:pointer;
  }

  .search-result:last-child {
    border-bottom:0;
  }

  .search-result:hover,
  .search-result.active {
    background:#edf5ff;
  }

  .selected-table {
    font-size:.78rem;
  }

  .selected-table th,
  .selected-table td {
    vertical-align:middle;
    white-space:nowrap;
  }

  .ap-number {
    font-weight:700;
    color:#0d6efd;
  }

  .selected-empty {
    padding:2.5rem 1rem;
    text-align:center;
    color:#6c757d;
  }

  .wo-selected {
    background:#e9f7ef;
    border:1px solid #badbcc;
    border-radius:.35rem;
    padding:.55rem .7rem;
    margin-top:.4rem;
  }

  .summary-count {
    font-size:1rem;
    font-weight:700;
  }

  @media print {
    .no-print {
      display:none !important;
    }
  }
</style>


<div class="issue-page">

  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">

    <div>
      <h3 class="mb-1">
        New Appliance Issue
      </h3>

      <div class="small text-muted">
        Issue appliances to technician for installation
      </div>
    </div>

    <a class="btn btn-outline-secondary btn-sm"
       href="{{ url_for('appliance.inventory_list') }}">
      ← Inventory
    </a>

  </div>


  <form method="post"
        id="issueForm"
        autocomplete="off">

    <div class="issue-card mb-3">
      <div class="p-3">

        <div class="row g-3">

          <div class="col-lg-3">

            <div class="issue-label">
              Warehouse *
            </div>

            <select class="form-select"
                    name="warehouse_id"
                    id="warehouseSelect"
                    required>

              {% for warehouse in warehouses %}

                <option value="{{ warehouse.id }}"
                        {% if warehouse.id == default_warehouse_id %}selected{% endif %}>
                  {{ warehouse.code|upper }}
                  — {{ warehouse.name|upper }}
                </option>

              {% endfor %}

            </select>

          </div>


          <div class="col-lg-3">

            <div class="issue-label">
              Technician / Employee *
            </div>

            <select class="form-select"
                    name="technician_id"
                    id="technicianSelect"
                    required>

              <option value="">
                SELECT TECHNICIAN...
              </option>

              {% for technician in technicians %}

                <option value="{{ technician.id }}">
                  {{ technician.username|upper }}
                </option>

              {% endfor %}

            </select>

          </div>


          <div class="col-lg-6">

            <div class="issue-label">
              Work Order *
            </div>

            <div class="search-box">

              <input type="search"
                     class="form-control"
                     id="workOrderSearch"
                     placeholder="TYPE W/O #"
                     autocomplete="off">

              <input type="hidden"
                     name="work_order_id"
                     id="workOrderId">

              <div id="workOrderResults"
                   class="search-results d-none">
              </div>

            </div>

            <div id="selectedWorkOrder"
                 class="wo-selected d-none">

              <div class="fw-bold"
                   id="selectedWoNumber">
              </div>

              <div class="small text-muted"
                   id="selectedWoInfo">
              </div>

            </div>

          </div>

        </div>

      </div>
    </div>


    <div class="issue-card mb-3">

      <div class="p-3 border-bottom">

        <div class="row g-2 align-items-end">

          <div class="col-lg-8">

            <div class="issue-label">
              Add Appliance
            </div>

            <div class="search-box">

              <input type="search"
                     class="form-control form-control-lg"
                     id="applianceSearch"
                     placeholder="SCAN OR TYPE AP # / SERIAL / MODEL / BRAND"
                     autocomplete="off">

              <div id="applianceResults"
                   class="search-results d-none">
              </div>

            </div>

            <div class="small text-muted mt-1">
              Scan barcode or start typing.
              Only AVAILABLE appliances from the selected warehouse are shown.
            </div>

          </div>


          <div class="col-lg-4 text-lg-end">

            <div class="text-muted small">
              SELECTED
            </div>

            <div class="summary-count">
              <span id="selectedCount">0</span>
              APPLIANCES
            </div>

          </div>

        </div>

      </div>


      <div class="table-responsive">

        <table class="table table-sm table-hover selected-table mb-0">

          <thead class="table-light">
            <tr>
              <th style="width:45px;">#</th>
              <th>AP #</th>
              <th>APPLIANCE</th>
              <th>BRAND</th>
              <th>MODEL</th>
              <th>SERIAL</th>
              <th>SIZE</th>
              <th>CONDITION</th>
              <th style="width:75px;"></th>
            </tr>
          </thead>

          <tbody id="selectedBody">

            <tr id="emptySelectedRow">
              <td colspan="9"
                  class="selected-empty">
                No appliances selected.
              </td>
            </tr>

          </tbody>

        </table>

      </div>

    </div>


    <div class="issue-card mb-3">
      <div class="p-3">

        <div class="issue-label">
          Notes
        </div>

        <textarea class="form-control"
                  name="notes"
                  rows="2"
                  maxlength="1000"
                  placeholder="OPTIONAL"></textarea>

      </div>
    </div>


    <div class="d-flex flex-wrap gap-2 justify-content-end mb-4">

      <a class="btn btn-outline-secondary"
         href="{{ url_for('appliance.inventory_list') }}">
        Cancel
      </a>

      <button type="submit"
              class="btn btn-success btn-lg"
              id="issueButton"
              disabled>
        ISSUE & PRINT
      </button>

    </div>

  </form>

</div>


<script>
(() => {
  "use strict";

  const warehouseSelect =
    document.getElementById("warehouseSelect");

  const technicianSelect =
    document.getElementById("technicianSelect");

  const woSearch =
    document.getElementById("workOrderSearch");

  const woId =
    document.getElementById("workOrderId");

  const woResults =
    document.getElementById("workOrderResults");

  const selectedWoBox =
    document.getElementById("selectedWorkOrder");

  const selectedWoNumber =
    document.getElementById("selectedWoNumber");

  const selectedWoInfo =
    document.getElementById("selectedWoInfo");

  const applianceSearch =
    document.getElementById("applianceSearch");

  const applianceResults =
    document.getElementById("applianceResults");

  const selectedBody =
    document.getElementById("selectedBody");

  const selectedCount =
    document.getElementById("selectedCount");

  const issueButton =
    document.getElementById("issueButton");

  const issueForm =
    document.getElementById("issueForm");


  const selectedUnits = new Map();

  let woTimer = null;
  let applianceTimer = null;


  function esc(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }


  function hideResults(element) {
    element.classList.add("d-none");
    element.innerHTML = "";
  }


  function updateSubmitState() {
    issueButton.disabled = !(
      warehouseSelect.value
      && technicianSelect.value
      && woId.value
      && selectedUnits.size > 0
    );
  }


  function clearWorkOrder() {
    woId.value = "";

    selectedWoBox.classList.add(
      "d-none"
    );

    selectedWoNumber.textContent = "";
    selectedWoInfo.textContent = "";

    updateSubmitState();
  }


  function selectWorkOrder(item) {
    woId.value = item.id;

    const visibleNumber =
      item.job_numbers
      || item.canonical_job
      || "";

    woSearch.value = visibleNumber;

    selectedWoNumber.textContent =
      "W/O: " + visibleNumber;

    const info = [];

    if (item.technician) {
      info.push(
        "ASSIGNED TECH: " + item.technician
      );
    }

    if (item.customer_po) {
      info.push(
        "PO: " + item.customer_po
      );
    }

    selectedWoInfo.textContent =
      info.join(" | ");

    selectedWoBox.classList.remove(
      "d-none"
    );

    hideResults(woResults);

    applianceSearch.focus();

    updateSubmitState();
  }


  async function searchWorkOrders() {
    const q = woSearch.value.trim();

    if (q.length < 2) {
      hideResults(woResults);
      return;
    }

    try {
      const url =
        {{ url_for(
          'appliance.issue_search_work_orders'
        )|tojson }}
        + "?q="
        + encodeURIComponent(q);

      const response = await fetch(url);

      const data = await response.json();

      if (!response.ok || !data.ok) {
        hideResults(woResults);
        return;
      }

      if (!data.items.length) {
        woResults.innerHTML =
          '<div class="search-result text-muted">'
          + 'NO WORK ORDERS FOUND'
          + '</div>';

        woResults.classList.remove(
          "d-none"
        );

        return;
      }

      woResults.innerHTML =
        data.items.map(
          item => `
            <div class="search-result"
                 data-wo-id="${item.id}">

              <div class="fw-bold">
                ${esc(item.job_numbers)}
              </div>

              <div class="small text-muted">
                ${item.technician
                    ? "TECH: " + esc(item.technician)
                    : ""
                }

                ${item.customer_po
                    ? " | PO: " + esc(item.customer_po)
                    : ""
                }
              </div>

            </div>
          `
        ).join("");

      woResults.classList.remove(
        "d-none"
      );

      woResults
        .querySelectorAll("[data-wo-id]")
        .forEach(
          element => {

            element.addEventListener(
              "click",
              () => {

                const id = Number(
                  element.dataset.woId
                );

                const item =
                  data.items.find(
                    row => row.id === id
                  );

                if (item) {
                  selectWorkOrder(item);
                }
              }
            );

          }
        );

    } catch (error) {
      console.error(error);
      hideResults(woResults);
    }
  }


  function renderSelected() {

    selectedBody.innerHTML = "";

    if (!selectedUnits.size) {

      selectedBody.innerHTML = `
        <tr id="emptySelectedRow">
          <td colspan="9"
              class="selected-empty">
            No appliances selected.
          </td>
        </tr>
      `;

      selectedCount.textContent = "0";

      updateSubmitState();
      return;
    }

    let number = 1;

    for (const item of selectedUnits.values()) {

      const row =
        document.createElement("tr");

      row.innerHTML = `
        <td class="text-center text-muted">
          ${number}
        </td>

        <td>
          <span class="ap-number">
            ${esc(item.inventory_number)}
          </span>

          <input type="hidden"
                 name="appliance_unit_ids"
                 value="${item.id}">
        </td>

        <td>
          ${esc(item.appliance_type)}
        </td>

        <td>
          ${esc(item.brand || "—")}
        </td>

        <td>
          ${esc(item.model || "—")}
        </td>

        <td class="fw-semibold">
          ${esc(item.serial || "—")}
        </td>

        <td>
          ${esc(item.size || "—")}
        </td>

        <td>
          ${esc(item.condition || "—")}
        </td>

        <td class="text-center">
          <button type="button"
                  class="btn btn-outline-danger btn-sm"
                  data-remove-id="${item.id}">
            REMOVE
          </button>
        </td>
      `;

      selectedBody.appendChild(row);

      number++;
    }

    selectedBody
      .querySelectorAll("[data-remove-id]")
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              selectedUnits.delete(
                Number(
                  button.dataset.removeId
                )
              );

              renderSelected();

              applianceSearch.focus();
            }
          );

        }
      );

    selectedCount.textContent =
      String(selectedUnits.size);

    updateSubmitState();
  }


  function addAppliance(item) {

    if (selectedUnits.has(item.id)) {
      applianceSearch.value = "";
      hideResults(applianceResults);
      applianceSearch.focus();
      return;
    }

    selectedUnits.set(
      item.id,
      item
    );

    renderSelected();

    applianceSearch.value = "";

    hideResults(applianceResults);

    applianceSearch.focus();
  }


  async function searchAppliances() {

    const q =
      applianceSearch.value.trim();

    const warehouseId =
      warehouseSelect.value;

    if (!warehouseId) {
      hideResults(applianceResults);
      return;
    }

    /*
      Scanner-friendly:
      show inventory after one character,
      but don't query on a completely empty input.
    */
    if (!q) {
      hideResults(applianceResults);
      return;
    }

    try {

      const url =
        {{ url_for(
          'appliance.issue_search_appliances'
        )|tojson }}
        + "?warehouse_id="
        + encodeURIComponent(
            warehouseId
          )
        + "&q="
        + encodeURIComponent(q);

      const response =
        await fetch(url);

      const data =
        await response.json();

      if (!response.ok || !data.ok) {
        hideResults(applianceResults);
        return;
      }

      const availableItems =
        data.items.filter(
          item => !selectedUnits.has(item.id)
        );

      if (!availableItems.length) {

        applianceResults.innerHTML =
          '<div class="search-result text-muted">'
          + 'NO AVAILABLE APPLIANCES FOUND'
          + '</div>';

        applianceResults.classList.remove(
          "d-none"
        );

        return;
      }

      applianceResults.innerHTML =
        availableItems.map(
          item => `
            <div class="search-result"
                 data-unit-id="${item.id}">

              <div class="d-flex justify-content-between gap-2">

                <div class="fw-bold">
                  ${esc(item.inventory_number)}
                  — ${esc(item.appliance_type)}
                </div>

                <div class="small">
                  ${esc(item.condition)}
                </div>

              </div>

              <div class="small">
                ${esc(item.brand || "—")}
                |
                ${esc(item.model || "—")}
              </div>

              <div class="small text-muted">
                SERIAL:
                <strong>
                  ${esc(item.serial || "—")}
                </strong>

                ${item.size
                    ? " | " + esc(item.size)
                    : ""
                }
              </div>

            </div>
          `
        ).join("");

      applianceResults.classList.remove(
        "d-none"
      );

      applianceResults
        .querySelectorAll("[data-unit-id]")
        .forEach(
          element => {

            element.addEventListener(
              "click",
              () => {

                const id = Number(
                  element.dataset.unitId
                );

                const item =
                  availableItems.find(
                    row => row.id === id
                  );

                if (item) {
                  addAppliance(item);
                }
              }
            );

          }
        );

      /*
        Scanner shortcut:
        if search matches exactly one AP# or Serial,
        pressing ENTER will add it immediately.
      */
      applianceResults._items =
        availableItems;

    } catch (error) {
      console.error(error);
      hideResults(applianceResults);
    }
  }


  woSearch.addEventListener(
    "input",
    () => {

      clearWorkOrder();

      clearTimeout(woTimer);

      woTimer = setTimeout(
        searchWorkOrders,
        220
      );

    }
  );


  applianceSearch.addEventListener(
    "input",
    () => {

      clearTimeout(applianceTimer);

      applianceTimer = setTimeout(
        searchAppliances,
        180
      );

    }
  );


  applianceSearch.addEventListener(
    "keydown",
    event => {

      if (event.key !== "Enter") {
        return;
      }

      const items =
        applianceResults._items
        || [];

      if (items.length === 1) {
        event.preventDefault();
        addAppliance(items[0]);
      }

    }
  );


  warehouseSelect.addEventListener(
    "change",
    () => {

      if (selectedUnits.size) {

        const confirmed = confirm(
          "Changing warehouse will clear "
          + "selected appliances. Continue?"
        );

        if (!confirmed) {
          return;
        }
      }

      selectedUnits.clear();
      renderSelected();

      applianceSearch.value = "";
      hideResults(applianceResults);

    }
  );


  technicianSelect.addEventListener(
    "change",
    updateSubmitState
  );


  document.addEventListener(
    "click",
    event => {

      if (
        !event.target.closest(
          "#workOrderSearch, #workOrderResults"
        )
      ) {
        hideResults(woResults);
      }

      if (
        !event.target.closest(
          "#applianceSearch, #applianceResults"
        )
      ) {
        hideResults(applianceResults);
      }

    }
  );


  /*
    Turn typed text to actual uppercase,
    not CSS-only uppercase.
  */
  document.addEventListener(
    "input",
    event => {

      const element = event.target;

      if (
        element.matches(
          '.issue-page input[type="text"],'
          + '.issue-page input[type="search"],'
          + '.issue-page textarea'
        )
      ) {

        const start =
          element.selectionStart;

        const end =
          element.selectionEnd;

        element.value =
          element.value.toUpperCase();

        if (
          start !== null
          && end !== null
          && typeof element.setSelectionRange
             === "function"
        ) {
          element.setSelectionRange(
            start,
            end
          );
        }
      }

    }
  );


  issueForm.addEventListener(
    "submit",
    event => {

      if (!technicianSelect.value) {
        event.preventDefault();
        alert("SELECT TECHNICIAN.");
        technicianSelect.focus();
        return;
      }

      if (!woId.value) {
        event.preventDefault();
        alert("SELECT WORK ORDER.");
        woSearch.focus();
        return;
      }

      if (!selectedUnits.size) {
        event.preventDefault();
        alert(
          "SELECT AT LEAST ONE APPLIANCE."
        );
        applianceSearch.focus();
        return;
      }

      issueButton.disabled = true;
      issueButton.textContent =
        "ISSUING...";
    }
  );


  renderSelected();

})();
</script>

{% endblock %}
