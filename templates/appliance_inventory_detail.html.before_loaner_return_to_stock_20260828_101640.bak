{% extends "base.html" %}
{% block content %}

<style>
  .unit-page {
    max-width:1200px;
    margin:0 auto;
  }

  .unit-card {
    background:#fff;
    border:1px solid #d9dee5;
    border-radius:.55rem;
    box-shadow:0 .15rem .45rem rgba(0,0,0,.07);
  }

  .unit-label {
    font-size:.68rem;
    font-weight:600;
    color:#6c757d;
    text-transform:uppercase;
    margin-bottom:.15rem;
  }

  .unit-value {
    font-weight:600;
  }

  .status-actions {
    border-top:1px solid #e1e5ea;
    margin-top:1.5rem;
    padding-top:1.25rem;
  }

  .action-card {
    border:1px solid #d9dee5;
    border-radius:.45rem;
    padding:1rem;
    background:#fafbfc;
  }

  .status-large {
    font-size:.85rem;
    padding:.45rem .65rem;
  }

  .movement-history {
    border-top:1px solid #e1e5ea;
    margin-top:1.5rem;
    padding-top:1.25rem;
  }

  .movement-row {
    border:1px solid #d9dee5;
    border-radius:.45rem;
    padding:.85rem 1rem;
    margin-bottom:.65rem;
    background:#fff;
  }

  .movement-title {
    font-weight:800;
    font-size:.9rem;
  }

  .movement-meta {
    font-size:.78rem;
    color:#6c757d;
  }

  .movement-detail {
    font-size:.82rem;
    margin-top:.3rem;
  }
</style>


<div class="unit-page">

  <div class="d-flex justify-content-between align-items-start mb-3">

    <div>

      <h3 class="mb-1">
        {{ unit.inventory_number }}
      </h3>

      <div class="small text-muted">
        Serialized Appliance
      </div>

    </div>

    <a class="btn btn-outline-secondary btn-sm"
       href="{{ url_for('appliance.inventory_list') }}">
      ← Inventory
    </a>

  </div>


  <div class="unit-card">

    <div class="p-4">

      <div class="row g-4">

        <div class="col-md-3">
          <div class="unit-label">Appliance</div>
          <div class="unit-value">
            {{ unit.category.name|upper if unit.category else '—' }}
          </div>
        </div>

        <div class="col-md-3">
          <div class="unit-label">Brand</div>
          <div class="unit-value">
            {{ (unit.brand or '—')|upper }}
          </div>
        </div>

        <div class="col-md-3">
          <div class="unit-label">Model</div>
          <div class="unit-value">
            {{ (unit.model_number or '—')|upper }}
          </div>
        </div>

        <div class="col-md-3">
          <div class="unit-label">Serial</div>
          <div class="unit-value">
            {{ (unit.serial_number or '—')|upper }}
          </div>
        </div>


        <div class="col-md-3">
          <div class="unit-label">Size</div>
          <div class="unit-value">
            {% if unit.size_value is not none %}
              {{ unit.size_value|round(1) }}
              {{ unit.size_unit or '' }}
            {% else %}
              —
            {% endif %}
          </div>
        </div>

        <div class="col-md-3">
          <div class="unit-label">Condition</div>
          <div class="unit-value">
            {{ (unit.condition or '')|replace('_', ' ')|upper }}
          </div>
        </div>


        <div class="col-md-3">

          <div class="unit-label">
            Stock Class
          </div>

          <div class="unit-value">

            {% if unit.stock_class == 'new' %}

              <span class="badge bg-primary">
                NEW
              </span>

            {% elif unit.stock_class == 'loaner' %}

              <span class="badge bg-info text-dark">
                LOANER
              </span>

            {% elif unit.stock_class == 'retail' %}

              <span class="badge bg-warning text-dark">
                RETAIL
              </span>

            {% else %}

              <span class="badge bg-secondary">
                {{ (unit.stock_class or '')|replace('_', ' ')|upper }}
              </span>

            {% endif %}

          </div>

        </div>


        <div class="col-md-3">
          <div class="unit-label">Warehouse</div>
          <div class="unit-value">
            {{ unit.warehouse.code|upper if unit.warehouse else '—' }}
          </div>
        </div>

        <div class="col-md-3">

          <div class="unit-label">
            Status
          </div>

          <div class="unit-value">

            {% if unit.status == 'available' %}

              <span class="badge bg-success status-large">
                AVAILABLE
              </span>

            {% elif unit.status == 'issued' %}

              <span class="badge bg-primary status-large">
                ISSUED
              </span>

            {% elif unit.status == 'repair' %}

              <span class="badge bg-warning text-dark status-large">
                REPAIR
              </span>

            {% elif unit.status == 'vendor_return_pending' %}

              <span class="badge bg-warning text-dark status-large">
                VENDOR RETURN PENDING
              </span>

            {% elif unit.status == 'vendor_return' %}

              <span class="badge bg-dark status-large">
                VENDOR RETURNED
              </span>

            {% elif unit.status == 'written_off' %}

              <span class="badge bg-danger status-large">
                WRITTEN OFF
              </span>

            {% else %}

              <span class="badge bg-secondary status-large">
                {{ (unit.status or '')|replace('_', ' ')|upper }}
              </span>

            {% endif %}

          </div>

        </div>


        {% if can_pricing %}

          <div class="col-md-3">

            <div class="unit-label">
              Cost
            </div>

            <div class="unit-value">

              {% if unit.unit_cost is not none %}
                ${{ '%.2f'|format(unit.unit_cost) }}
              {% else %}
                MISSING
              {% endif %}

            </div>

          </div>

          <div class="col-md-3">

            <div class="unit-label">
              Selling Price
            </div>

            <div class="unit-value">

              {% if unit.selling_price is not none %}
                ${{ '%.2f'|format(unit.selling_price) }}
              {% else %}
                —
              {% endif %}

            </div>

          </div>

        {% endif %}


        <div class="col-md-6">

          <div class="unit-label">
            Notes
          </div>

          <div class="unit-value">
            {{ unit.notes or '—' }}
          </div>

        </div>

      </div>


      <!-- ==================================================
           STATUS / DISPOSITION ACTIONS
           ================================================== -->

      <div class="status-actions">

        <h5 class="mb-3">
          Appliance Actions
        </h5>


        {% if unit.status == 'available' %}

          <div class="row g-3">

            <div class="col-lg-4">

              <div class="action-card h-100">

                <div class="fw-bold mb-2">
                  Send to Repair
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'SEND THIS APPLIANCE TO REPAIR?'
                      );">

                  <input type="hidden"
                         name="action"
                         value="SEND_TO_REPAIR">

                  <select name="reason_code"
                          class="form-select form-select-sm mb-2">

                    <option value="NEEDS_REPAIR">
                      NEEDS REPAIR
                    </option>

                    <option value="DAMAGED">
                      DAMAGED
                    </option>

                    <option value="NOT_WORKING">
                      NOT WORKING
                    </option>

                    <option value="OTHER">
                      OTHER
                    </option>

                  </select>

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Notes">

                  <button class="btn btn-warning btn-sm">
                    SEND TO REPAIR
                  </button>

                </form>

              </div>

            </div>


            <div class="col-lg-4">

              <div class="action-card h-100">

                <div class="fw-bold mb-2">
                  Return to Vendor
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'MARK THIS APPLIANCE FOR VENDOR RETURN?'
                      );">

                  <input type="hidden"
                         name="action"
                         value="MARK_VENDOR_RETURN">

                  <select name="reason_code"
                          class="form-select form-select-sm mb-2">

                    <option value="DEFECTIVE">
                      DEFECTIVE
                    </option>

                    <option value="DAMAGED">
                      DAMAGED
                    </option>

                    <option value="WRONG_ITEM">
                      WRONG ITEM
                    </option>

                    <option value="OTHER">
                      OTHER
                    </option>

                  </select>

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Vendor / RMA / Notes">

                  <button class="btn btn-outline-dark btn-sm">
                    MARK FOR VENDOR RETURN
                  </button>

                </form>

              </div>

            </div>


            <div class="col-lg-4">

              <div class="action-card h-100">

                <div class="fw-bold mb-2">
                  Scrap / Write Off
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'SCRAP THIS APPLIANCE?\\n\\n' +
                        'It will no longer be AVAILABLE.'
                      );">

                  <input type="hidden"
                         name="action"
                         value="SCRAP">

                  <select name="reason_code"
                          class="form-select form-select-sm mb-2">

                    <option value="UNREPAIRABLE">
                      UNREPAIRABLE
                    </option>

                    <option value="DAMAGED">
                      DAMAGED
                    </option>

                    <option value="MISSING_PARTS">
                      MISSING PARTS
                    </option>

                    <option value="OTHER">
                      OTHER
                    </option>

                  </select>

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Notes">

                  <button class="btn btn-outline-danger btn-sm">
                    SCRAP
                  </button>

                </form>

              </div>

            </div>

          </div>


        {% elif unit.status == 'repair' %}

          {% set repair_event = namespace(item=None) %}

          {% for movement in movements %}

            {% if (
                repair_event.item is none
                and movement.movement_type == 'SEND_TO_REPAIR'
            ) %}

              {% set repair_event.item = movement %}

            {% endif %}

          {% endfor %}


          <div class="action-card mb-3">

            <div class="fw-bold mb-2">
              Appliance is currently in Repair
            </div>

            <div class="small text-muted mb-2">

              Choose what happens to this physical appliance
              after repair / inspection.

            </div>


            {% if repair_event.item %}

              <div class="small">

                {% if repair_event.item.created_at %}

                  <div>
                    <strong>Sent:</strong>
                    {{ repair_event.item.created_at.strftime(
                        '%m/%d/%Y %I:%M %p'
                    ) }}
                  </div>

                {% endif %}


                {% if repair_event.item.actor %}

                  <div>
                    <strong>Sent By:</strong>
                    {{ repair_event.item.actor.username|upper }}
                  </div>

                {% endif %}


                {% if repair_event.item.reason_code %}

                  <div>
                    <strong>Reason:</strong>
                    {{ repair_event.item.reason_code
                       |replace('_', ' ')
                       |upper }}
                  </div>

                {% endif %}


                {% if repair_event.item.notes %}

                  <div>
                    <strong>Notes:</strong>
                    {{ repair_event.item.notes }}
                  </div>

                {% endif %}

              </div>

            {% endif %}

          </div>


          <div class="row g-3">


            <!-- =============================================
                 1. RETURN AS NEW
                 ============================================= -->

            <div class="col-lg-6 col-xl-3">

              <div class="action-card h-100">

                <div class="fw-bold mb-1">
                  Return to New Stock
                </div>

                <div class="small text-muted mb-2">
                  Use only when no actual repair was needed
                  and appliance can still be treated as NEW.
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'RETURN THIS APPLIANCE TO NEW STOCK?\n\n' +
                        'Use this only if no actual repair was required.'
                      );">

                  <input type="hidden"
                         name="action"
                         value="RETURN_FROM_REPAIR_TO_NEW">

                  <input type="hidden"
                         name="reason_code"
                         value="NO_REPAIR_REQUIRED">

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Inspection / notes">

                  <button class="btn btn-outline-primary btn-sm">
                    RETURN TO NEW STOCK
                  </button>

                </form>

              </div>

            </div>


            <!-- =============================================
                 2. MOVE TO LOANER
                 ============================================= -->

            <div class="col-lg-6 col-xl-3">

              <div class="action-card h-100">

                <div class="fw-bold mb-1">
                  Move to Loaner Stock
                </div>

                <div class="small text-muted mb-2">

                  Repaired appliance enters the
                  replacement / loaner pool.

                  <br>

                  <strong>
                    LOANER · REPAIRED · AVAILABLE
                  </strong>

                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'MOVE THIS REPAIRED APPLIANCE TO LOANER STOCK?'
                      );">

                  <input type="hidden"
                         name="action"
                         value="RETURN_FROM_REPAIR_TO_LOANER">

                  <input type="hidden"
                         name="reason_code"
                         value="REPAIR_COMPLETED">

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Repair completed / notes">

                  <button class="btn btn-success btn-sm">
                    MOVE TO LOANER
                  </button>

                </form>

              </div>

            </div>


            <!-- =============================================
                 3. VENDOR RETURN
                 ============================================= -->

            <div class="col-lg-6 col-xl-3">

              <div class="action-card h-100">

                <div class="fw-bold mb-1">
                  Vendor Return
                </div>

                <div class="small text-muted mb-2">
                  Repair failed or unit should go back
                  to supplier.
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'MOVE THIS APPLIANCE TO VENDOR RETURN PENDING?'
                      );">

                  <input type="hidden"
                         name="action"
                         value="REPAIR_TO_VENDOR_RETURN">

                  <select name="reason_code"
                          class="form-select form-select-sm mb-2">

                    <option value="REPAIR_FAILED_VENDOR_RETURN">
                      REPAIR FAILED
                    </option>

                    <option value="DEFECTIVE">
                      DEFECTIVE
                    </option>

                    <option value="PARTS_NOT_AVAILABLE">
                      PARTS NOT AVAILABLE
                    </option>

                    <option value="OTHER">
                      OTHER
                    </option>

                  </select>

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Vendor / RMA / notes">

                  <button class="btn btn-outline-dark btn-sm">
                    VENDOR RETURN
                  </button>

                </form>

              </div>

            </div>


            <!-- =============================================
                 4. SCRAP
                 ============================================= -->

            <div class="col-lg-6 col-xl-3">

              <div class="action-card h-100">

                <div class="fw-bold mb-1">
                  Scrap / Write Off
                </div>

                <div class="small text-muted mb-2">
                  Appliance cannot be repaired or is not
                  economically worth repairing.
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'SCRAP THIS APPLIANCE?\n\n' +
                        'This appliance will be WRITTEN OFF.'
                      );">

                  <input type="hidden"
                         name="action"
                         value="REPAIR_TO_SCRAP">

                  <select name="reason_code"
                          class="form-select form-select-sm mb-2">

                    <option value="UNREPAIRABLE">
                      UNREPAIRABLE
                    </option>

                    <option value="REPAIR_TOO_EXPENSIVE">
                      REPAIR TOO EXPENSIVE
                    </option>

                    <option value="PARTS_NOT_AVAILABLE">
                      PARTS NOT AVAILABLE
                    </option>

                    <option value="DAMAGED">
                      DAMAGED
                    </option>

                    <option value="OTHER">
                      OTHER
                    </option>

                  </select>

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Write-off notes">

                  <button class="btn btn-outline-danger btn-sm">
                    SCRAP / WRITE OFF
                  </button>

                </form>

              </div>

            </div>


          </div>


        {% elif unit.status == 'vendor_return_pending' %}

          <div class="row g-3">

            <div class="col-lg-6">

              <div class="action-card h-100">

                <div class="fw-bold mb-2">
                  Vendor Return Pending
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'CONFIRM THIS APPLIANCE WAS RETURNED TO VENDOR?'
                      );">

                  <input type="hidden"
                         name="action"
                         value="CONFIRM_VENDOR_RETURN">

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="RMA / Pickup / Tracking">

                  <button class="btn btn-dark btn-sm">
                    CONFIRM VENDOR RETURN
                  </button>

                </form>

              </div>

            </div>


            <div class="col-lg-6">

              <div class="action-card h-100">

                <div class="fw-bold mb-2">
                  Cancel Vendor Return
                </div>

                <form method="post"
                      action="{{ url_for(
                          'appliance.inventory_disposition',
                          unit_id=unit.id
                      ) }}"
                      onsubmit="return confirm(
                        'CANCEL VENDOR RETURN AND MAKE THIS AVAILABLE AGAIN?'
                      );">

                  <input type="hidden"
                         name="action"
                         value="CANCEL_VENDOR_RETURN">

                  <input name="notes"
                         class="form-control form-control-sm mb-2"
                         placeholder="Reason for cancellation">

                  <button class="btn btn-outline-success btn-sm">
                    CANCEL RETURN
                  </button>

                </form>

              </div>

            </div>

          </div>


        {% elif unit.status == 'issued' %}

          <div class="alert alert-primary mb-0">

            This appliance is currently
            <strong>ISSUED</strong>.

            Use the Appliance Issue page for
            <strong>RETURN TO STOCK</strong>,
            <strong>REPLACE APPLIANCE</strong>,
            or <strong>CHANGE W/O</strong>.

          </div>


        {% elif unit.status == 'vendor_return' %}

          <div class="alert alert-secondary mb-0">

            This appliance has been returned to the vendor
            and is no longer available for warehouse issue.

          </div>


        {% elif unit.status == 'written_off' %}

          <div class="alert alert-danger mb-0">

            This appliance has been written off / scrapped
            and is no longer available for warehouse issue.

          </div>

        {% endif %}

      </div>


      <!-- ==================================================
           MOVEMENT HISTORY
           ================================================== -->

      <div class="movement-history">

        <div class="d-flex justify-content-between align-items-center mb-3">

          <h5 class="mb-0">
            Movement History
          </h5>

          <span class="badge bg-secondary">
            {{ movements|length }}
            MOVEMENT{{ '' if movements|length == 1 else 'S' }}
          </span>

        </div>


        {% if movements %}

          {% for movement in movements %}

            <div class="movement-row">

              <div class="d-flex justify-content-between align-items-start gap-3">

                <div>

                  <div class="movement-title">

                    {% if movement.movement_type == 'ISSUE' %}
                      ISSUE

                    {% elif movement.movement_type == 'RETURN_TO_STOCK' %}
                      RETURN TO STOCK

                    {% elif movement.movement_type == 'REPLACE_OUT' %}
                      REPLACED OUT

                    {% elif movement.movement_type == 'REPLACE_IN' %}
                      REPLACED IN

                    {% elif movement.movement_type == 'SEND_TO_REPAIR' %}
                      SENT TO REPAIR

                    {% elif movement.movement_type == 'RETURN_FROM_REPAIR' %}
                      RETURNED FROM REPAIR

                    {% elif movement.movement_type == 'VENDOR_RETURN_PENDING' %}
                      VENDOR RETURN PENDING

                    {% elif movement.movement_type == 'VENDOR_RETURN' %}
                      RETURNED TO VENDOR

                    {% elif movement.movement_type == 'VENDOR_RETURN_CANCEL' %}
                      VENDOR RETURN CANCELLED

                    {% elif movement.movement_type == 'SCRAP' %}
                      SCRAPPED / WRITTEN OFF

                    {% else %}
                      {{ (movement.movement_type or '')|replace('_', ' ')|upper }}
                    {% endif %}

                  </div>


                  <div class="movement-meta">

                    {% if movement.created_at %}
                      {{ movement.created_at.strftime('%m/%d/%Y %I:%M %p') }}
                    {% endif %}

                    {% if movement.actor %}
                      · BY {{ movement.actor.username|upper }}
                    {% endif %}

                  </div>

                </div>


                {% if movement.reason_code %}

                  <span class="badge bg-light text-dark border">
                    {{ movement.reason_code|replace('_', ' ')|upper }}
                  </span>

                {% endif %}

              </div>


              <div class="movement-detail">

                {% if movement.issue %}

                  <div>
                    <strong>AIS:</strong>

                    <a href="{{ url_for(
                        'appliance.issue_detail',
                        issue_id=movement.issue.id
                    ) }}">
                      {{ movement.issue.issue_number }}
                    </a>
                  </div>

                {% endif %}


                {% if movement.from_work_order_number
                      or movement.to_work_order_number %}

                  <div>

                    <strong>W/O:</strong>

                    {% if movement.from_work_order_number %}
                      {{ movement.from_work_order_number|upper }}
                    {% endif %}

                    {% if movement.from_work_order_number
                          and movement.to_work_order_number %}
                      →
                    {% endif %}

                    {% if movement.to_work_order_number %}
                      {{ movement.to_work_order_number|upper }}
                    {% endif %}

                  </div>

                {% endif %}


                {% if movement.technician %}

                  <div>
                    <strong>Technician:</strong>
                    {{ movement.technician.username|upper }}
                  </div>

                {% endif %}


                {% if movement.related_appliance_unit %}

                  <div>

                    <strong>Related Appliance:</strong>

                    <a href="{{ url_for(
                        'appliance.inventory_detail',
                        unit_id=movement.related_appliance_unit.id
                    ) }}">

                      {{ movement.related_appliance_unit.inventory_number }}

                    </a>

                    ·
                    {{ (movement.related_appliance_unit.brand or '—')|upper }}
                    |
                    {{ (movement.related_appliance_unit.model_number or '—')|upper }}
                    |
                    {{ (movement.related_appliance_unit.serial_number or '—')|upper }}

                  </div>

                {% endif %}


                {% if movement.from_warehouse
                      or movement.to_warehouse %}

                  <div>

                    <strong>Warehouse:</strong>

                    {% if movement.from_warehouse %}
                      {{ movement.from_warehouse.code|upper }}
                    {% endif %}

                    {% if movement.from_warehouse
                          and movement.to_warehouse %}
                      →
                    {% endif %}

                    {% if movement.to_warehouse %}
                      {{ movement.to_warehouse.code|upper }}
                    {% endif %}

                  </div>

                {% endif %}


                {% if movement.notes %}

                  <div class="mt-1">
                    <strong>Notes:</strong>
                    {{ movement.notes }}
                  </div>

                {% endif %}

              </div>

            </div>

          {% endfor %}


        {% else %}

          <div class="alert alert-light border mb-0">
            No movement history found for this appliance.
          </div>

        {% endif %}

      </div>

    </div>

  </div>

</div>

{% endblock %}
