{% extends "base.html" %}
{% block content %}

<style>

  .vr-page {
    max-width:1500px;
    margin:0 auto;
  }

  .vr-card {
    background:#fff;
    border:1px solid #d9dee5;
    border-radius:.6rem;
    box-shadow:0 .15rem .45rem rgba(0,0,0,.06);
  }

  .vr-stat {
    min-width:180px;
    padding:.85rem 1rem;
    border:1px solid #d9dee5;
    border-radius:.55rem;
    background:#fff;
  }

  .vr-stat-title {
    font-size:.68rem;
    color:#6c757d;
    font-weight:800;
    text-transform:uppercase;
  }

  .vr-stat-number {
    font-size:1.45rem;
    font-weight:800;
    line-height:1.15;
  }

  .vr-table {
    font-size:.82rem;
  }

  .vr-table th {
    white-space:nowrap;
    font-size:.7rem;
    text-transform:uppercase;
    color:#495057;
  }

  .vr-table td {
    vertical-align:middle;
  }

  .vr-ap {
    font-weight:800;
    white-space:nowrap;
  }

</style>


<div class="vr-page">

  <div class="d-flex justify-content-between align-items-start mb-3">

    <div>

      <h3 class="mb-1">
        Appliance Vendor Returns
      </h3>

      <div class="small text-muted">
        Review pending supplier returns and record final disposition.
      </div>

    </div>

    <a class="btn btn-outline-secondary btn-sm"
       href="{{ url_for(
           'appliance.inventory_list'
       ) }}">
      ← Inventory
    </a>

  </div>


  <div class="d-flex flex-wrap gap-2 mb-3">

    <div class="vr-stat">

      <div class="vr-stat-title">
        Action Required
      </div>

      <div class="vr-stat-number">
        {{ pending_count }}
      </div>

      <div class="small text-muted">
        Waiting for final decision
      </div>

    </div>


    <div class="vr-stat">

      <div class="vr-stat-title">
        Returned History
      </div>

      <div class="vr-stat-number">
        {{ history_count }}
      </div>

      <div class="small text-muted">
        Confirmed Vendor Returns
      </div>

    </div>

  </div>


  <!-- =====================================================
       ACTION REQUIRED
       ===================================================== -->

  <div class="vr-card mb-4">

    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">

      <div>

        <div class="fw-bold">
          Action Required
        </div>

        <div class="small text-muted">
          Appliances still physically under company control
          and blocked from Issue.
        </div>

      </div>

      {% if pending_count %}

        <span class="badge bg-warning text-dark">
          {{ pending_count }} PENDING
        </span>

      {% else %}

        <span class="badge bg-success">
          CLEAR
        </span>

      {% endif %}

    </div>


    <div class="table-responsive">

      <table class="table table-sm table-hover vr-table mb-0">

        <thead class="table-light">

          <tr>
            <th>AP #</th>
            <th>Appliance</th>
            <th>Model / Serial</th>
            <th>Class</th>
            <th>Vendor</th>
            <th>Purchase Inv</th>
            <th>Reason</th>
            <th>Marked</th>
            <th>By</th>
            <th>Decision</th>
          </tr>

        </thead>

        <tbody>

          {% for row in pending_rows %}

            {% set unit = row.unit %}
            {% set movement = row.movement %}

            <tr>

              <td>

                <a class="vr-ap"
                   href="{{ url_for(
                       'appliance.inventory_detail',
                       unit_id=unit.id
                   ) }}"
                   title="Open full appliance history">

                  {{ unit.inventory_number }}

                </a>

              </td>


              <td>

                <div class="fw-bold">
                  {{ unit.category.name|upper if unit.category else '—' }}
                </div>

                <div class="small text-muted">
                  {{ (unit.brand or '—')|upper }}
                </div>

              </td>


              <td>

                <div>
                  {{ (unit.model_number or '—')|upper }}
                </div>

                <div class="fw-semibold">
                  {{ (unit.serial_number or '—')|upper }}
                </div>

              </td>


              <td>

                {% if unit.stock_class == 'loaner' %}

                  <span class="badge bg-info text-dark">
                    LOANER
                  </span>

                {% else %}

                  <span class="badge bg-light text-dark border">
                    {{ (unit.stock_class or 'new')|upper }}
                  </span>

                {% endif %}

              </td>


              <td class="fw-semibold">
                {{ (row.vendor_name or '—')|upper }}
              </td>


              <td>
                {{ (row.purchase_invoice or '—')|upper }}
              </td>


              <td>

                {% if movement and movement.reason_code %}

                  <span class="badge bg-light text-dark border">
                    {{ movement.reason_code
                       |replace('_', ' ')
                       |upper }}
                  </span>

                {% else %}
                  —
                {% endif %}

              </td>


              <td>

                {% if movement and movement.created_at_local %}

                  {{ movement.created_at_local.strftime(
                      '%m/%d/%Y'
                  ) }}

                  <div class="small text-muted">
                    {{ movement.created_at_local.strftime(
                        '%I:%M %p'
                    ) }}
                  </div>

                {% else %}
                  —
                {% endif %}

              </td>


              <td>

                {{ movement.actor.username|upper
                   if movement and movement.actor
                   else '—' }}

              </td>


              <td>

                <a class="btn btn-primary btn-sm"
                   href="{{ url_for(
                       'appliance.vendor_return_action',
                       unit_id=unit.id
                   ) }}">
                  REVIEW / ACTION
                </a>

              </td>

            </tr>


          {% else %}

            <tr>

              <td colspan="10"
                  class="text-center py-4">

                <div class="fw-bold text-success mb-1">
                  No Vendor Returns require action.
                </div>

                <div class="small text-muted">
                  The pending queue is clear.
                </div>

              </td>

            </tr>

          {% endfor %}

        </tbody>

      </table>

    </div>

  </div>


  <!-- =====================================================
       HISTORY
       ===================================================== -->

  <div class="vr-card">

    <div class="p-3 border-bottom">

      <div class="fw-bold">
        Return History
      </div>

      <div class="small text-muted">
        Confirmed physical Vendor Returns. Latest 500 records.
      </div>

    </div>


    <div class="table-responsive">

      <table class="table table-sm table-hover vr-table mb-0">

        <thead class="table-light">

          <tr>
            <th>Returned</th>
            <th>AP #</th>
            <th>Appliance</th>
            <th>Model / Serial</th>
            <th>Class</th>
            <th>Vendor</th>
            <th>Purchase Inv</th>
            <th>RMA / Ref</th>
            <th>Reason</th>
            <th>Confirmed By</th>
          </tr>

        </thead>

        <tbody>

          {% for row in history_rows %}

            {% set unit = row.unit %}
            {% set movement = row.movement %}

            <tr>

              <td>

                {% if movement.created_at_local %}

                  {{ movement.created_at_local.strftime(
                      '%m/%d/%Y'
                  ) }}

                  <div class="small text-muted">
                    {{ movement.created_at_local.strftime(
                        '%I:%M %p'
                    ) }}
                  </div>

                {% else %}
                  —
                {% endif %}

              </td>


              <td>

                {% if unit %}

                  <a class="vr-ap"
                     href="{{ url_for(
                         'appliance.inventory_detail',
                         unit_id=unit.id
                     ) }}">
                    {{ unit.inventory_number }}
                  </a>

                {% else %}
                  —
                {% endif %}

              </td>


              <td>

                {% if unit %}

                  <div class="fw-bold">
                    {{ unit.category.name|upper
                       if unit.category
                       else '—' }}
                  </div>

                  <div class="small text-muted">
                    {{ (unit.brand or '—')|upper }}
                  </div>

                {% else %}
                  —
                {% endif %}

              </td>


              <td>

                {% if unit %}

                  <div>
                    {{ (unit.model_number or '—')|upper }}
                  </div>

                  <div class="fw-semibold">
                    {{ (unit.serial_number or '—')|upper }}
                  </div>

                {% else %}
                  —
                {% endif %}

              </td>


              <td>
                {{ (unit.stock_class or 'new')|upper
                   if unit
                   else '—' }}
              </td>


              <td class="fw-semibold">
                {{ (row.vendor_name or '—')|upper }}
              </td>


              <td>
                {{ (row.purchase_invoice or '—')|upper }}
              </td>


              <td class="fw-semibold">
                {{ row.rma_reference or '—' }}
              </td>


              <td>

                {{ (movement.reason_code or '—')
                   |replace('_', ' ')
                   |upper }}

              </td>


              <td>

                {{ movement.actor.username|upper
                   if movement.actor
                   else '—' }}

              </td>

            </tr>


          {% else %}

            <tr>

              <td colspan="10"
                  class="text-center text-muted py-4">

                No confirmed Vendor Returns yet.

              </td>

            </tr>

          {% endfor %}

        </tbody>

      </table>

    </div>

  </div>

</div>

{% endblock %}
