{% extends "base.html" %}
{% block content %}

<style>
  .appliance-inventory-page {
    width:calc(100vw - 40px);
    max-width:1800px;
    margin-left:50%;
    transform:translateX(-50%);
  }

  .inventory-toolbar {
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:.75rem;
    margin-bottom:1rem;
  }

  .inventory-card {
    background:#fff;
    border:1px solid #d9dee5;
    border-radius:.55rem;
    box-shadow:0 .15rem .45rem rgba(0,0,0,.07);
  }

  .inventory-table {
    font-size:.76rem;
  }

  .inventory-table th,
  .inventory-table td {
    vertical-align:middle;
    white-space:nowrap;
  }

  .inventory-table tbody tr.unit-row {
    cursor:pointer;
  }

  .inventory-table tbody tr.unit-row:hover {
    background:#f4f8fc;
  }

  .inventory-number {
    font-weight:700;
    color:#0d6efd;
  }

  .serial-number {
    font-weight:600;
  }

  .status-badge {
    font-size:.66rem;
    letter-spacing:.03em;
  }

  .filter-label {
    font-size:.68rem;
    font-weight:600;
    color:#6c757d;
    text-transform:uppercase;
    margin-bottom:.2rem;
  }

  .missing-cost {
    background:#fff3cd;
  }

  .inventory-category-row td {
    background:#e9ecef !important;
    border-top:2px solid #adb5bd !important;
    border-bottom:1px solid #adb5bd !important;
    font-size:.76rem;
    font-weight:700;
  }

  .inventory-category-name {
    font-size:.78rem;
    letter-spacing:.04em;
  }

  .inventory-category-count {
    font-size:.65rem;
  }

  .inventory-stat {
    display:inline-flex;
    align-items:center;
    gap:.3rem;
    padding:.28rem .5rem;
    border:1px solid #d7dce2;
    border-radius:.35rem;
    background:#fff;
    font-size:.72rem;
  }

  .inventory-stat strong {
    font-size:.8rem;
  }

  .issue-link {
    font-weight:700;
    text-decoration:none;
  }

  .issue-link:hover {
    text-decoration:underline;
  }

  .issued-row {
    background:#f5f9ff;
  }

  .wo-value {
    font-weight:700;
  }


  /* ======================================================
     Vendor Return operational control
     ====================================================== */

  .vendor-return-top-btn {
    display:inline-flex;
    align-items:center;
    gap:.38rem;
    font-weight:800;
    white-space:nowrap;
    letter-spacing:.01em;
  }

  .vendor-return-top-btn.has-pending {
    background:#ffc107;
    border-color:#e0a800;
    color:#212529;
    box-shadow:0 .08rem .2rem rgba(0,0,0,.12);
  }

  .vendor-return-top-btn.has-pending:hover {
    background:#eeb300;
    border-color:#d39e00;
    color:#111;
  }

  .vendor-return-top-btn.no-pending {
    background:#fff;
    border-color:#adb5bd;
    color:#495057;
  }

  .vendor-return-count {
    min-width:1.35rem;
    height:1.35rem;
    padding:0 .3rem;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    font-size:.68rem;
    font-weight:900;
    line-height:1;
  }

  .vendor-return-top-btn.has-pending .vendor-return-count {
    background:#dc3545;
    color:#fff;
  }



  /* SAFE INVENTORY FINAL POLISH */


  /* ======================================================
     TOP OPERATIONAL TOOLBAR
     ====================================================== */

  .vendor-return-top-btn {
    min-height:30px;
    padding:.32rem .58rem !important;

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:.3rem;

    font-size:.73rem;
    font-weight:800;
    letter-spacing:.01em;
    white-space:nowrap;

    border-radius:.32rem;
  }

  .vendor-return-top-btn.has-pending {
    background:#ffc107;
    border-color:#dba900;
    color:#212529;

    box-shadow:
      0 .08rem .18rem rgba(0,0,0,.11);
  }

  .vendor-return-top-btn.has-pending:hover {
    background:#eeb500;
    border-color:#c99a00;
    color:#111;
  }

  .vendor-return-top-btn.no-pending {
    background:#fff;
    border-color:#adb5bd;
    color:#495057;
  }

  .vendor-return-count {
    min-width:1.22rem;
    height:1.22rem;

    padding:0 .28rem;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    border-radius:999px;

    /*
      Pending itself is already communicated by the
      yellow button. Dark counter is cleaner than a
      second competing red alert.
    */
    background:#343a40 !important;
    color:#fff !important;

    font-size:.65rem;
    font-weight:900;
    line-height:1;
  }


  /* ======================================================
     FILTER PANEL
     
     NO LAYOUT CHANGES.
     Only typography / controls.
     ====================================================== */

  .filter-label {
    color:#68717a;

    font-size:.64rem;
    font-weight:800;

    letter-spacing:.035em;
  }

  .form-control-sm,
  .form-select-sm {
    min-height:31px;
  }


  /* ======================================================
     INVENTORY REGISTRY
     ====================================================== */

  .table {
    /*
      Existing structure stays unchanged.
      Slightly improve reading rhythm.
    */
    font-size:.80rem;
  }

  .table thead th {
    padding-top:.46rem;
    padding-bottom:.46rem;

    color:#3e474f;

    font-size:.66rem;
    font-weight:800;

    letter-spacing:.025em;

    vertical-align:middle;
  }

  .table tbody td {
    padding-top:.40rem;
    padding-bottom:.40rem;

    line-height:1.25;
    vertical-align:middle;
  }

  .table tbody tr:not(.table-secondary):hover td {
    background:#f7faff;
  }


  /* ======================================================
     CATEGORY GROUP ROWS
     ====================================================== */

  .table-secondary td,
  tr.table-secondary td {

    /*
      Slightly stronger separation between
      REFRIGERATOR / WASHER / DRYER / ...
    */

    background:#e9edf1 !important;

    color:#283038;

    font-weight:800;

    border-top-color:#cbd2d9 !important;
    border-bottom-color:#cbd2d9 !important;
  }


  /* ======================================================
     AP NUMBER
     ====================================================== */

  .table a {
    text-underline-offset:2px;
  }


  /* ======================================================
     STATUS + STOCK CLASS
     
     Existing HTML already contains:
       .status-badge
       .inventory-stock-class
     
     No template modification required.
     ====================================================== */

  .status-badge {
    display:inline-flex;
    align-items:center;

    font-weight:800;

    line-height:1.1;

    white-space:nowrap;
  }


  .inventory-stock-class {
    display:inline-flex;
    align-items:center;

    /*
      Give visible separation from STATUS.
    */
    margin-left:.34rem;

    vertical-align:middle;
  }


  /*
    NEW should be secondary information.
    Status is more important.
  */

  .inventory-stock-class > span:not(.badge) {
    color:#7a838b !important;

    font-size:.62rem !important;
    font-weight:700 !important;

    letter-spacing:.015em;

    white-space:nowrap;
  }


  /*
    LOANER remains deliberately more visible because
    warehouse staff must identify loaner inventory quickly.
  */

  .inventory-stock-class .badge {
    padding:.18rem .38rem;

    font-size:.64rem;
    font-weight:800;

    line-height:1;

    border-radius:.28rem;
  }


  /* ======================================================
     VENDOR RETURN STATES
     ====================================================== */

  /*
    PENDING should be noticeable but readable.
    We do not change business status or markup.
  */

  .status-badge.bg-secondary {
    border:1px solid rgba(0,0,0,.08);
  }


  /* ======================================================
     SECONDARY TABLE INFORMATION
     ====================================================== */

  /*
    Date columns and placeholder dashes should not compete
    visually with AP#, status, vendor-return state, etc.
  */

  .table td {
    color:#252b31;
  }

  .table td.text-muted,
  .table .text-muted {
    color:#747d85 !important;
  }


  /* ======================================================
     SMALL SCREEN SAFETY
     ====================================================== */

  @media (max-width: 1100px) {

    .table {
      font-size:.76rem;
    }

    .table thead th {
      font-size:.63rem;
    }

    .inventory-stock-class {
      margin-left:.22rem;
    }

  }


</style>


<div class="appliance-inventory-page">

  <div class="inventory-toolbar">

    <div>

      <h3 class="mb-1">
        Appliance Inventory
      </h3>

      <div class="small text-muted">
        Complete serialized appliance registry
      </div>

    </div>


    <div class="d-flex flex-wrap gap-2 align-items-center">

      <span class="inventory-stat">
        TOTAL
        <strong>
          {{ total_count }}
        </strong>
      </span>

      <span class="inventory-stat">
        AVAILABLE
        <strong class="text-success">
          {{ available_count }}
        </strong>
      </span>

      <span class="inventory-stat">
        ISSUED
        <strong class="text-primary">
          {{ issued_count }}
        </strong>
      </span>

      <a class="btn btn-primary btn-sm"
         href="{{ url_for('appliance.issue_new') }}">
        + New Issue
      </a>

      <a class="btn btn-outline-primary btn-sm"
         href="{{ url_for('appliance.receiving_list') }}">
        Receiving
      </a>

      <a href="{{ url_for('appliance.vendor_returns_queue') }}"
         class="
           btn btn-sm
           vendor-return-top-btn
           {% if vendor_return_pending_count %}
             has-pending
           {% else %}
             no-pending
           {% endif %}
         "
         title="
           {% if vendor_return_pending_count %}
             {{ vendor_return_pending_count }}
             appliance(s) require Vendor Return action
           {% else %}
             No Vendor Returns require action
           {% endif %}
         ">

        <span aria-hidden="true">
          ↩
        </span>

        <span>
          VENDOR RETURNS
        </span>

        {% if vendor_return_pending_count %}

          <span class="vendor-return-count">
            {{ vendor_return_pending_count }}
          </span>

        {% endif %}

      </a>


    </div>

  </div>


  <!-- ======================================================
       FILTERS
       ====================================================== -->

  <div class="inventory-card mb-3">

    <div class="p-3">

      <form method="get"
            action="{{ url_for('appliance.inventory_list') }}">

        <div class="row g-2">


          <div class="col-xl-4 col-md-6">

            <div class="filter-label">
              Search
            </div>

            <input type="search"
                   class="form-control form-control-sm"
                   name="q"
                   value="{{ q or '' }}"
                   placeholder="AP # / SERIAL / MODEL / BRAND / AIS # / TECH / W/O">

          </div>


          <div class="col-xl-2 col-md-3">

            <div class="filter-label">
              Warehouse
            </div>

            <select class="form-select form-select-sm"
                    name="warehouse_id">

              <option value="">
                ALL
              </option>

              {% for warehouse in warehouses %}

                <option value="{{ warehouse.id }}"
                        {% if warehouse_id == warehouse.id %}selected{% endif %}>
                  {{ warehouse.code|upper }}
                </option>

              {% endfor %}

            </select>

          </div>


          <div class="col-xl-2 col-md-3">

            <div class="filter-label">
              Appliance
            </div>

            <select class="form-select form-select-sm"
                    name="category_id">

              <option value="">
                ALL
              </option>

              {% for category in categories %}

                <option value="{{ category.id }}"
                        {% if category_id == category.id %}selected{% endif %}>
                  {{ category.name|upper }}
                </option>

              {% endfor %}

            </select>

          </div>


          <div class="col-xl-2 col-md-3">

            <div class="filter-label">
              Status
            </div>

            <select class="form-select form-select-sm"
                    name="status">

              <option value="all"
                      {% if status == 'all' %}selected{% endif %}>
                ALL
              </option>

              <option value="available"
                      {% if status == 'available' %}selected{% endif %}>
                AVAILABLE
              </option>

              <option value="issued"
                      {% if status == 'issued' %}selected{% endif %}>
                ISSUED
              </option>

              <option value="repair"
                      {% if status == 'repair' %}selected{% endif %}>
                REPAIR
              </option>

              <option value="vendor_return_pending"
                      {% if status == 'vendor_return_pending' %}selected{% endif %}>
                VENDOR RETURN PENDING
              </option>

              <option value="reserved"
                      {% if status == 'reserved' %}selected{% endif %}>
                RESERVED
              </option>

              <option value="transferred"
                      {% if status == 'transferred' %}selected{% endif %}>
                TRANSFERRED
              </option>

              <option value="vendor_return"
                      {% if status == 'vendor_return' %}selected{% endif %}>
                VENDOR RETURN
              </option>

              <option value="sold"
                      {% if status == 'sold' %}selected{% endif %}>
                SOLD
              </option>

              <option value="written_off"
                      {% if status == 'written_off' %}selected{% endif %}>
                WRITTEN OFF
              </option>

            </select>

          </div>


          <div class="col-xl-2 col-md-3">

            <div class="filter-label">
              Stock Class
            </div>

            <select class="form-select form-select-sm"
                    name="stock_class">

              <option value=""
                      {% if not stock_class %}selected{% endif %}>
                ALL
              </option>

              <option value="new"
                      {% if stock_class == 'new' %}selected{% endif %}>
                NEW
              </option>

              <option value="loaner"
                      {% if stock_class == 'loaner' %}selected{% endif %}>
                LOANER
              </option>

              <option value="retail"
                      {% if stock_class == 'retail' %}selected{% endif %}>
                RETAIL
              </option>

            </select>

          </div>


          <div class="col-xl-2 col-md-3">

            <div class="filter-label">
              Condition
            </div>

            <select class="form-select form-select-sm"
                    name="condition">

              <option value="">
                ALL
              </option>

              <option value="new"
                      {% if condition == 'new' %}selected{% endif %}>
                NEW
              </option>

              <option value="used"
                      {% if condition == 'used' %}selected{% endif %}>
                USED
              </option>

              <option value="open_box"
                      {% if condition == 'open_box' %}selected{% endif %}>
                OPEN BOX
              </option>

              <option value="damaged"
                      {% if condition == 'damaged' %}selected{% endif %}>
                DAMAGED
              </option>

              <option value="repaired"
                      {% if condition == 'repaired' %}selected{% endif %}>
                REPAIRED
              </option>

            </select>

          </div>

        </div>


        <div class="d-flex gap-2 mt-3">

          <button type="submit"
                  class="btn btn-primary btn-sm">
            Search
          </button>

          <a class="btn btn-outline-secondary btn-sm"
             href="{{ url_for('appliance.inventory_list') }}">
            Clear
          </a>

        </div>

      </form>

    </div>

  </div>


  


  <!-- ======================================================
       REGISTRY
       ====================================================== -->

  <div class="inventory-card">

    <div class="table-responsive">

      <table class="table table-sm table-hover inventory-table mb-0">

        <thead class="table-light">

          <tr>

            <th>AP #</th>
            <th>APPLIANCE</th>
            <th>BRAND</th>
            <th>MODEL</th>
            <th>SERIAL</th>
            <th>WAREHOUSE</th>

            {% if can_pricing %}
              <th class="text-end">COST</th>
              <th class="text-end">SELL</th>
            {% endif %}

            <th>STATUS / CLASS</th>

            <th>CURRENT ISSUE</th>
            <th>HISTORY</th>
            <th>TECHNICIAN</th>
            <th>W/O #</th>
            <th>ISSUED</th>

            <th>RECEIVED</th>

          </tr>

        </thead>


        <tbody>

          {% for group in grouped_units %}

            {% set column_count = 15 if can_pricing else 13 %}

            <tr class="inventory-category-row">

              <td colspan="{{ column_count }}"
                  class="py-2">

                <span class="inventory-category-name">
                  {{ group.category.name|upper if group.category else 'OTHER' }}
                </span>

                <span class="badge bg-dark ms-2 inventory-category-count">

                  {{ group.units|length }}

                  UNIT{% if group.units|length != 1 %}S{% endif %}

                </span>

              </td>

            </tr>


            {% for unit in group.units %}

              {% set issued = issue_info.get(unit.id) %}
              {% set history = issue_history.get(unit.id, []) %}

              <tr class="unit-row {% if unit.status == 'issued' %}issued-row{% endif %}"
                  onclick="window.location.href='{{ url_for('appliance.inventory_detail', unit_id=unit.id) }}'">


                <td>

                  <span class="inventory-number">
                    {{ unit.inventory_number }}
                  </span>

                </td>


                <td class="fw-semibold">

                  {{ unit.category.name|upper if unit.category else '—' }}

                </td>


                <td>
                  {{ (unit.brand or '—')|upper }}
                </td>


                <td>
                  {{ (unit.model_number or '—')|upper }}
                </td>


                <td>

                  <span class="serial-number">
                    {{ (unit.serial_number or '—')|upper }}
                  </span>

                </td>


                <td>
                  {{ unit.warehouse.code|upper if unit.warehouse else '—' }}
                </td>


                {% if can_pricing %}

                  <td class="text-end {% if unit.unit_cost is none %}missing-cost{% endif %}">

                    {% if unit.unit_cost is not none %}

                      ${{ '%.2f'|format(unit.unit_cost) }}

                    {% else %}

                      MISSING

                    {% endif %}

                  </td>


                  <td class="text-end">

                    {% if unit.selling_price is not none %}

                      ${{ '%.2f'|format(unit.selling_price) }}

                    {% else %}

                      —

                    {% endif %}

                  </td>

                {% endif %}


                <td>

                  {% if unit.status == 'available' %}

                    <span class="badge bg-success status-badge">
                      AVAILABLE
                    </span>

                  {% elif unit.status == 'issued' %}

                    <span class="badge bg-primary status-badge">
                      ISSUED
                    </span>

                  {% elif unit.status == 'reserved' %}

                    <span class="badge bg-warning text-dark status-badge">
                      RESERVED
                    </span>

                  {% elif unit.status == 'sold' %}

                    <span class="badge bg-dark status-badge">
                      SOLD
                    </span>

                  {% elif unit.status == 'written_off' %}

                    <span class="badge bg-danger status-badge">
                      WRITTEN OFF
                    </span>

                  {% else %}

                    <span class="badge bg-secondary status-badge">

                      {{ (unit.status or '')|replace('_', ' ')|upper }}

                    </span>

                  {% endif %}


                  {# ========================================
                     STOCK CLASS
                     ======================================== #}

                  {% set unit_stock_class =
                      (unit.stock_class or 'new')|lower %}

                  <span class="inventory-stock-class">

                    {% if unit_stock_class == 'loaner' %}

                      <span class="badge bg-info text-dark status-badge ms-1">
                        LOANER
                      </span>

                    {% elif unit_stock_class == 'retail' %}

                      <span class="badge bg-warning text-dark status-badge ms-1">
                        RETAIL
                      </span>

                    {% elif unit_stock_class == 'new' %}

                      <span class="text-muted ms-1"
                            style="
                              font-size:.64rem;
                              font-weight:700;
                              white-space:nowrap;
                            ">
                        NEW
                      </span>

                    {% else %}

                      <span class="badge bg-secondary status-badge ms-1">
                        {{ unit_stock_class
                           |replace('_', ' ')
                           |upper }}
                      </span>

                    {% endif %}

                  </span>

                </td>


                <!-- CURRENT ISSUE -->

                <td>

                  {% if (
                      unit.status == 'issued'
                      and issued
                      and issued.line_status == 'issued'
                  ) %}

                    <a class="issue-link"
                       href="{{ url_for(
                           'appliance.issue_detail',
                           issue_id=issued.issue_id
                       ) }}"
                       onclick="event.stopPropagation();">

                      {{ issued.issue_number }}

                    </a>

                  {% else %}

                    —

                  {% endif %}

                </td>


                <!-- COMPLETE AIS HISTORY -->

                <td onclick="event.stopPropagation();">

                  {% if history %}

                    <details>

                      <summary style="
                          cursor:pointer;
                          font-weight:700;
                          color:#0d6efd;
                          white-space:nowrap;
                      ">
                        {{ history|length }}
                        AIS
                      </summary>

                      <div style="
                          min-width:185px;
                          padding:.35rem 0;
                      ">

                        {% for h in history %}

                          <div style="
                              display:flex;
                              align-items:center;
                              justify-content:space-between;
                              gap:.6rem;
                              margin-bottom:.2rem;
                          ">

                            <a href="{{ url_for(
                                   'appliance.issue_detail',
                                   issue_id=h.issue_id
                               ) }}"
                               class="issue-link">

                              {{ h.issue_number }}

                            </a>


                            {% if h.line_status == 'issued' %}

                              <span class="badge bg-primary">
                                ISSUED
                              </span>

                            {% elif h.line_status == 'returned' %}

                              <span class="badge bg-success">
                                RETURNED
                              </span>

                            {% else %}

                              <span class="badge bg-secondary">
                                {{ (h.line_status or '')|replace('_', ' ')|upper }}
                              </span>

                            {% endif %}

                          </div>

                        {% endfor %}

                      </div>

                    </details>

                  {% else %}

                    —

                  {% endif %}

                </td>


                <!-- TECHNICIAN -->

                <td>

                  {% if issued and issued.technician %}

                    {{ issued.technician|upper }}

                  {% else %}

                    —

                  {% endif %}

                </td>


                <!-- W/O -->

                <td class="wo-value">

                  {% if issued and issued.work_order_number %}

                    {{ issued.work_order_number|upper }}

                  {% elif unit.current_work_order_number %}

                    {{ unit.current_work_order_number|upper }}

                  {% else %}

                    —

                  {% endif %}

                </td>


                <!-- ISSUED DATE -->

                <td class="text-muted small">

                  {% if issued and issued.issued_at %}

                    {{ issued.issued_at.strftime('%m/%d/%Y') }}

                  {% else %}

                    —

                  {% endif %}

                </td>


                <!-- RECEIVED -->

                <td class="text-muted small">

                  {% if unit.created_at_local %}

                    {{ unit.created_at_local.strftime('%m/%d/%Y') }}

                  {% else %}

                    —

                  {% endif %}

                </td>

              </tr>

            {% endfor %}


          {% else %}

            <tr>

              <td colspan="{{ 15 if can_pricing else 13 }}"
                  class="text-center text-muted py-5">

                No appliance units found.

              </td>

            </tr>

          {% endfor %}

        </tbody>

      </table>

    </div>

  </div>


  {% if units|length >= 500 %}

    <div class="alert alert-warning mt-3 py-2">

      Showing first 500 matching units.
      Use Search or filters to narrow the registry.

    </div>

  {% endif %}

</div>

{% endblock %}
